{
  "expo": {
    "name": "Bible Detective",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D12"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.praisetechzw.mobile",
      "statusBar": {
        "backgroundColor": "#0C6AF86",
        "barStyle": "light"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "07a8cd95-41b6-47c3-9fa8-79fb498a65d9"
      }
    },
    "owner": "praisetechzw"
  }
}
